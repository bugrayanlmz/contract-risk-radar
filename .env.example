ENVIRONMENT=development
ALLOW_REAL_DOCUMENTS=false
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
JWT_SECRET=local-demo-only-change-this-secret-before-hosting
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Choose exactly one provider for the app; the eval runner can compare both.
LLM_PROVIDER=claude
# Set an exact structured-output-capable model identifier from your provider account.
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Required only for multi-workspace Claude API keys; omit for a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
